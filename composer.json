{
    "name": "dma/dma_simple_grid",
    "description": "Contao Extension for simple multiple grid-support",
    "keywords": [
        "contao",
        "extension",
        "module",
        "grid"
    ],
    "type": "contao-bundle",
    "homepage": "https://www.dma.do",
    "license": "LGPL-3.0+",
    "authors": [
        {
            "name": "DMA GmbH",
            "homepage": "http://www.dma.do",
            "role": "origin maintainer"
        },
        {
            "name": "Janosch Oltmanns",
            "email": "kontakt@janosch-oltmanns.de",
            "homepage": "https://www.janosch-oltmanns.de",
            "role": "maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/DMAGmbH/dma_simple_grid/issues",
        "source": "https://github.com/DMAGmbH/dma_simple_grid"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3",
        "doctrine/dbal": "^3.6 || ^4.0",
        "menatwork/contao-multicolumnwizard-bundle": "^3.6",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.12",
        "contao/test-case": "^5.3 || ^6.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Dma\\DmaSimpleGrid\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dma\\DmaSimpleGrid\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Dma\\DmaSimpleGrid\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false,
            "contao-community-alliance/composer-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --fix --ansi",
        "cs-check": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --ansi",
        "phpstan": "@php tools/phpstan/vendor/bin/phpstan analyse src tests",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    }
}
